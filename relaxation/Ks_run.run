printf "-=--==-==-=-=---=-=-==-=-==-=-=-=-=-=-=-==-==-=-=-=---==-===-=-=-=-=-=-=--=-=-=-=-==-=-=---=-=---- \n";
reset; 

printf "monem \n";
model Ks_monem.mod; 
data Knapsack.dat; 

option solver cplex; 

solve;        

printf "constraint values \n";
display sum {j in X} a1[j]*x[j];
display sum {j in X} a2[j]*x[j];
display sum {j in X} a2[j]*x[j];
display sum {j in X} a2[j]*x[j];

printf "constraint bounds \n";
display sum {j in X} a1[j] / 2;
display sum {j in X} a2[j] / 2;
display sum {j in X} a3[j] / 2;
display sum {j in X} a4[j] / 2;


